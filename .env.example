# Copy to .env (chmod 600). Used by `npm run dev` / `npm run preview` and by docker compose.

# Port for `npm run dev`, `npm run preview`, and the host port Docker publishes.
PORT=18320
# Host interface Docker publishes PORT on. 127.0.0.1 keeps it on loopback (the tailnet uses the
# tailscale sidecar instead); 0.0.0.0 also exposes it on the LAN and the Mac's tailnet IP.
BIND_ADDR=127.0.0.1
# CPA Manager Plus (Full Mode) Manager Server. For `npm run dev` use http://127.0.0.1:18317;
# docker compose defaults to http://host.docker.internal:18317 when this is unset.
MANAGER_URL=http://127.0.0.1:18317
# Extra hostnames to allow (comma separated). *.ts.net, *.local and localhost are always allowed.
ALLOWED_HOSTS=
# Set to 443 when the dev server sits behind `tailscale serve` HTTPS.
HMR_CLIENT_PORT=

# Tailscale sidecar (docker compose service `tailscale`).
# Machine name on the tailnet: https://<TS_HOSTNAME>.<tailnet>.ts.net
TS_HOSTNAME=cpa-usage
# Reusable or one-off auth key from the Tailscale admin console. Only needed for the first join;
# the node identity is then kept in ./tailscale/state. Never commit it.
TS_AUTHKEY=tskey-auth-REPLACE_ME
